# Neon pooled connection (host mengandung "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon direct connection (untuk prisma migrate)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# String acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-panjang
# OAuth client ID bertipe "Web application"
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
# Base URL publik untuk URL foto profil (production: https://love-tracking-api.vercel.app)
PUBLIC_BASE_URL=http://localhost:3000
